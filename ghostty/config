theme = Monokai Pro Spectrum
font-family = MesloLGS Nerd Font Mono
font-size = 15
font-thicken = true
background = #222222
foreground = #f7f1ff
bold-color = #eaf2f1
selection-background = #39383a
selection-foreground = #eaf2f1
cursor-style = block
cursor-style-blink = false
cursor-color = #f7f1ff
cursor-text = #ffffff
shell-integration-features = no-cursor
background-opacity = 1
background-blur = false
macos-titlebar-style = native
macos-window-buttons = visible
macos-option-as-alt = true
window-decoration = auto
maximize = true
window-width = 180
window-height = 55
scrollback-limit = 3000
unfocused-split-opacity = 1
split-divider-color = #69676c

# Navigate Ghostty splits/panes with Option/Alt + Vim keys.
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right

# tmux Cmd-key workflow.
# Ghostty cannot make keybinds conditional on "inside tmux". These bindings
# override Ghostty's default Cmd shortcuts and send tmux User-key escape
# sequences to the foreground program. tmux maps those sequences in
# ~/.config/tmux/tmux.conf.
keybind = super+d=text:\x1b[5;30000~
keybind = super+shift+d=text:\x1b[5;30001~

keybind = super+h=text:\x1b[5;30002~
keybind = super+j=text:\x1b[5;30003~
keybind = super+k=text:\x1b[5;30004~
keybind = super+l=text:\x1b[5;30005~

keybind = super+shift+h=text:\x1b[5;30006~
keybind = super+shift+j=text:\x1b[5;30007~
keybind = super+shift+k=text:\x1b[5;30008~
keybind = super+shift+l=text:\x1b[5;30009~

keybind = super+s=text:\x1b[5;30010~
keybind = super+e=text:\x1b[5;30023~
keybind = super+x=text:\x1b[5;30011~
keybind = super+t=text:\x1b[5;30012~
keybind = super+n=text:\x1b[5;30013~

keybind = super+digit_1=text:\x1b[5;30014~
keybind = super+1=text:\x1b[5;30014~
keybind = super+digit_2=text:\x1b[5;30015~
keybind = super+2=text:\x1b[5;30015~
keybind = super+digit_3=text:\x1b[5;30016~
keybind = super+3=text:\x1b[5;30016~
keybind = super+digit_4=text:\x1b[5;30017~
keybind = super+4=text:\x1b[5;30017~
keybind = super+digit_5=text:\x1b[5;30018~
keybind = super+5=text:\x1b[5;30018~
keybind = super+digit_6=text:\x1b[5;30019~
keybind = super+6=text:\x1b[5;30019~
keybind = super+digit_7=text:\x1b[5;30020~
keybind = super+7=text:\x1b[5;30020~
keybind = super+digit_8=text:\x1b[5;30021~
keybind = super+8=text:\x1b[5;30021~
keybind = super+digit_9=text:\x1b[5;30022~
keybind = super+9=text:\x1b[5;30022~
